-- Errors inside a generic function show up at the calls that instantiate
-- it, with a note for each call on the way there. The same arguments give
-- the same instance, checked (and reported) once.
input x : Vec 2 = [1, 2]
input y : Vec 3 = [1, 2, 3]

fn sq(z) = z @ z
fn twice(v) = sq(v) + sq(v)

let a = sq(x)
let b = twice(y)
let c = twice(y)
let d = sq(2)
