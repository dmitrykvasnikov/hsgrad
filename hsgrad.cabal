cabal-version:      3.4
name:               hsgrad
version:            0.1.0.0
synopsis:           Scalar reverse-mode autodiff with a small model language
description:
  A Haskell re-implementation of Karpathy's micrograd, extended with a
  declarative .hsg language, symbolic gradients and good error messages.
  See docs/00-architecture.md.
category:           Math, Machine Learning
author:             Dmitry Kvasnikov
maintainer:         dmitry.kvasnikov@gmail.com
build-type:         Simple
tested-with:        GHC == 9.10.3
extra-doc-files:    docs/*.md

-- Settings shared by every component (library, executable, tests).
common shared
  default-language: GHC2021
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wredundant-constraints
    -Wpartial-fields
    -Wmissing-export-lists
    -Wunused-packages
  build-depends:    base ^>=4.20

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
    , HsGrad
    , HsGrad.Core.Backprop
    , HsGrad.Core.Eval
    , HsGrad.Core.Graph
    , HsGrad.Core.Op
    , HsGrad.Core.Pretty
    , HsGrad.Core.Simplify
    , HsGrad.Core.Symbolic
    , HsGrad.Lang.Diagnostic
    , HsGrad.Lang.Span
    , HsGrad.Train.Loop
    , HsGrad.Train.Optim
    , HsGrad.Train.Param
    , HsGrad.Viz.Dot
  build-depends:
    , containers  ^>=0.7
    , mtl         ^>=2.3
    , random      ^>=1.3
    , text        ^>=2.1
  other-modules:    Paths_hsgrad
  autogen-modules:  Paths_hsgrad

executable hsgrad
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:    hsgrad
  ghc-options:      -rtsopts

test-suite spec
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Main.hs
  other-modules:
    , HsGrad.Core.BackpropSpec
    , HsGrad.Core.EvalSpec
    , HsGrad.Core.GraphSpec
    , HsGrad.Core.OpSpec
    , HsGrad.Core.PrettySpec
    , HsGrad.Core.SimplifySpec
    , HsGrad.Core.SymbolicSpec
    , HsGrad.Lang.DiagnosticSpec
    , HsGrad.Lang.SpanSpec
    , HsGrad.Test.Examples
    , HsGrad.Test.Golden
    , HsGrad.Test.Graphs
    , HsGrad.Train.LoopSpec
    , HsGrad.Train.OptimSpec
    , HsGrad.Train.ParamSpec
    , HsGrad.Viz.DotSpec
    , HsGradSpec
  build-depends:
    , containers  ^>=0.7
    , directory   ^>=1.3
    , filepath    ^>=1.5
    , hsgrad
    , hspec       ^>=2.11
    , mtl         ^>=2.3
    , process     ^>=1.6
    , QuickCheck  ^>=2.19
    , text        ^>=2.1
