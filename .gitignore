# cabal: build output and machine-local settings
dist-newstyle/
cabal.project.local*
.ghc.environment.*

# GHC runtime output (profiles, heap profiles, eventlogs)
*.prof
*.hp
*.eventlog

# Generated Graphviz graphs and pictures
*.dot
*.svg
*.png
# ...except the pictures in the docs, which are committed on purpose
!docs/img/*.svg
